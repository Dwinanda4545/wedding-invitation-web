# Laravel API (wedding-invitation-api). No trailing slash.
# Copy to .env and adjust. Restart `npm run dev` after changing this.

# Local Sanctum (recommended): empty = Vite same-origin + proxy
VITE_API_BASE_URL=

# Cross-origin (will 419 CSRF from localhost:5173 → *.test)
# VITE_API_BASE_URL=http://wedding-invitation-api.test
# VITE_API_BASE_URL=http://localhost:8000

# Optional proxy target override (vite.config.ts)
# VITE_DEV_API_PROXY=http://wedding-invitation-api.test

# Pusher (Buku Tamu realtime) — same key/cluster as API
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=ap1
